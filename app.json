{
  "expo": {
    "name": "Puertas Santander",
    "slug": "puertas-santander",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font", 
      "expo-web-browser",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "This app needs access to camera for video calls with intercoms.",
          "microphonePermission": "This app needs access to microphone for voice calls with intercoms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fba05647-50d4-4815-afdd-0f8d93bf7a94"
      }
    },
    "android": {
      "package": "com.cess07.puertassantander"
    }
  }
}
