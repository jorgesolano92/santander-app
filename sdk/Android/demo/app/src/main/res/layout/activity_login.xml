<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white" >

    <TextView
        android:id="@+id/login_text_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text=""
        android:gravity="center_horizontal"
        android:textColor="@color/blue"
        android:textSize="19sp" />

    <LinearLayout
        android:id="@+id/login_username_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_text_tip"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UserName"
            android:textColor="@color/text_tip_color"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/login_edit_username"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/edit_bg"
            android:gravity="center_vertical"
            android:hint="username"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="admin"
            android:textColor="@color/text_normal_color"
            android:textColorHint="@color/text_tip_color"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_password_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_username_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PassWord"
            android:textColor="@color/text_tip_color"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/login_edit_password"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:background="@drawable/edit_bg"
            android:gravity="center_vertical"
            android:hint="password"
            android:inputType="textPassword"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="123456"
            android:textColor="@color/text_normal_color"
            android:textColorHint="@color/text_tip_color"
            android:textSize="17sp" />
        <Button
            android:id="@+id/btnSeePwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="see"
            android:textColor="@color/black"
            android:textSize="17sp"
            />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/login_radiogroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_password_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal" >

        <RadioButton
            android:id="@+id/login_device_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="IP"
            android:textColor="@color/text_normal_color"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/login_device_domair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="Domain"
            android:textColor="@color/text_normal_color"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/login_device_p2p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="P2P"
            android:textColor="@color/text_normal_color"
            android:textSize="15sp" />
        <RadioButton
            android:id="@+id/login_device_p2p2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="P2P 2.0"
            android:textColor="@color/text_normal_color"
            android:textSize="15sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/login_service_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_radiogroup"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service    "
            android:textColor="@color/text_tip_color"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/login_edit_service"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/edit_bg"
            android:gravity="center_vertical"
            android:hint="service"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="192.168.8.148"
            android:textColor="@color/text_normal_color"
            android:textColorHint="@color/text_tip_color"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_port_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_service_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port          "
            android:textColor="@color/text_tip_color"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/login_edit_port"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/edit_bg"
            android:gravity="center_vertical"
            android:hint="port"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="6036"
            android:textColor="@color/text_normal_color"
            android:textColorHint="@color/text_tip_color"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_sn_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_port_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DeviceSn"
            android:textColor="@color/text_tip_color"
            android:textSize="17sp"/>

        <EditText
            android:id="@+id/login_edit_sn"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/edit_bg"
            android:enabled="false"
            android:gravity="center_vertical"
            android:hint="Device Sn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="2A9EBB26F7D7"
            android:textColor="@color/text_tip_color"
            android:textColorHint="@color/text_tip_color"
            android:textSize="17sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/login_next"
        android:layout_width="320dp"
        android:layout_height="38dp"
        android:layout_below="@id/login_sn_content"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/button_bg"
        android:gravity="center_horizontal|center_vertical"
        android:text="Next"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/login_bottom_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_next"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="@color/blue"
        android:textSize="17sp" />

    <Button
        android:id="@+id/log_onoff"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_alignStart="@+id/login_next"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="-10dp"
        android:layout_marginBottom="31dp"
        android:background="@drawable/button_bg"
        android:gravity="bottom"
        android:text="enable_NativeLog"
        android:textColor="@color/white"
        android:textSize="17sp" />


</RelativeLayout>
