<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      HTTPS/WSS con el panel: certificado emitido por la CA propia de la instalación
      (res/raw/santander_ca.crt, generada con backend/scripts/tls_ca.py). No se confía en
      CAs instaladas por el usuario para evitar interceptación.
      Se mantiene HTTP en claro para equipos que no admiten TLS (videoporteros CSIP/RTSP, ESP32).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/santander_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
